{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "foobar",
      "camelcase": "Foobar",
      "title": "Foobar",
      "scope": "source.foobar",
      "file-types": [
        "foobar"
      ],
      "injection-regex": "^foobar$",
      "class-name": "TreeSitterFoobar"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Grammar for example language Foobar",
    "authors": [
      {
        "name": "tfachmann",
        "email": "tfachmann@proton.me",
        "url": "https://github.com/tfachmann"
      }
    ],
    "links": {
      "repository": "https://github.com/tfachmann/tree-sitter-foobar",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}